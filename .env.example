# ==================================================================
# NeuralCarbon — Master Environment Configuration
# ==================================================================
# Copy this file to `.env` in the root directory for Docker runs,
# or to `backend/.env` for manual backend runs.
# ==================================================================

# --- BACKEND CONFIGURATION ---
# The URL for the Redis instance used by the Drift Monitoring background worker.
# For Docker Compose: redis://cache:6379
# For Local Run: redis://localhost:6379
REDIS_URL=redis://cache:6379

# Database Configuration (Optional)
# If not set, falls back to local SQLite: ./neuralcarbon.db
DATABASE_URL=sqlite:///./neuralcarbon.db

# [OPTIONAL] OpenWeatherMap API Key for live weather data integration.
# Get one at: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# [OPTIONAL] Web3 Provider URL for real blockchain anchoring (e.g., Infura/Alchemy)
# Example: https://polygon-mumbai.infura.io/v3/your_project_id
WEB3_PROVIDER_URL=

# [OPTIONAL] Wallet Private Key for signing blockchain transactions
# CAUTION: Never commit real keys to version control.
WALLET_PRIVATE_KEY=

# --- FRONTEND CONFIGURATION ---
# The URL of the backend API.
# Development: http://localhost:8000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
