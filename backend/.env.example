# ==================================================================
# NeuralCarbon Backend — Environment Variables
# ==================================================================
# Copy this file to `.env` and fill in the values.
# ==================================================================

# ---------- Database (Supabase / PostgreSQL) ----------
# If not set, falls back to local SQLite: ./neuralcarbon.db
# For production, use a Supabase or TimescaleDB connection string.
SUPABASE_URL=sqlite:///./neuralcarbon.db

# ---------- Phase 6: Blockchain Ledger (Web3) ----------
# Required only if you want real on-chain anchoring.
# Get a free key from https://www.alchemy.com or https://infura.io
# Example: https://polygon-mumbai.g.alchemy.com/v2/YOUR_KEY
WEB3_PROVIDER_URL=

# Private key of a funded wallet (for signing transactions).
# NEVER commit this to version control.
WEB3_WALLET_PRIVATE_KEY=

# ---------- Weather API ----------
# If you want real-time weather instead of mock data.
# Get a free key from https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=

# ---------- CORS ----------
# Comma-separated list of allowed origins for production.
# Example: https://your-vercel-app.vercel.app
CORS_ORIGINS=*
